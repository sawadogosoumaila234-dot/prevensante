# Dépendances et artefacts de build
node_modules/
dist/
coverage/
*.tsbuildinfo

# Artefacts de test Playwright
web/test-results/
web/playwright-report/

# Secrets — NE JAMAIS committer
.env
.env.*
!.env.example

# Vercel
.vercel/

# Supabase (temporaires locaux uniquement — aucun conteneur dans ce projet)
supabase/.temp/
supabase/.branches/

# Divers
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Ajouts automatiques par Vercel CLI (doublons des règles ci-dessus)
.vercel
.env*

# Cette exception DOIT rester en dernier : dans .gitignore, le dernier motif
# qui correspond gagne. Sans elle, le '.env*' ajouté par Vercel ignore aussi
# le modèle .env.example, qui doit rester versionné.
!.env.example
