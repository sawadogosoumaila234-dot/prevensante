# ---------------------------------------------------------------------------
# Modèle de variables d'environnement.
# Copier ce fichier vers .env puis renseigner les valeurs réelles.
# .env est ignoré par git — ne jamais y placer un secret dans un fichier versionné.
# ---------------------------------------------------------------------------

# --- Application ---
PORT=3000
NODE_ENV=development

# --- Supabase DISTANT (aucun Supabase local, aucun Docker dans ce projet) ---
# Obtenir les valeurs dans : Supabase Dashboard > Project Settings > API
# SUPABASE_URL=https://<reference-projet>.supabase.co
# SUPABASE_ANON_KEY=                       # clé publique, utilisable côté client
# SUPABASE_SERVICE_ROLE_KEY=               # SECRET — serveur uniquement, jamais dans le navigateur

# --- Vercel ---
# Les variables Development/Preview/Production se gèrent côté Vercel :
#   vercel env pull .env.local
# Ne pas les recopier à la main ici.
