# Variables d'environnement du front (Vite). Pour travailler en local :
#   cp .env.example .env.local
#
# ⚠️ Ce fichier ne doit contenir QUE des variables `VITE_*` publiques.
#    Toute variable prefixee `VITE_` est embarquee dans le bundle du
#    navigateur : n'y mettez jamais la cle `service_role`, qui doit rester
#    cote serveur.
#
# SANS ces deux variables, l'application tourne en MODE DEMO : les donnees
# viennent du jeu de demonstration local (web/src/data/demo.ts) et la RLS est
# emulee dans le code (web/src/lib/rls/scope.ts).
# AVEC ces deux variables, l'application lit la vraie base Supabase et la RLS
# est appliquee par PostgreSQL (supabase/migrations/0011_rls_policies.sql).

# URL du projet — Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Cle « anon » — Supabase Dashboard > Project Settings > API > Project API keys
VITE_SUPABASE_ANON_KEY=
